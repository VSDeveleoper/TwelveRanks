<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Chess12x.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="GameModeButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="MinHeight" Value="72" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="48,40">
            <StackPanel
                MaxWidth="760"
                HorizontalAlignment="Center"
                Spacing="14">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="44"
                    FontWeight="SemiBold"
                    Text="Chess12x" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24"
                    FontSize="18"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Choose how you want to begin a new 12 × 12 game."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Button
                    Click="NewGameButton_Click"
                    Style="{StaticResource GameModeButtonStyle}"
                    Tag="LocalTwoPlayer">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Two players — local" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Share this device and play from the same board."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Click="NewGameButton_Click"
                    Style="{StaticResource GameModeButtonStyle}"
                    Tag="Computer">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Play against the computer" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="A conventional computer opponent will be added later."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Click="NewGameButton_Click"
                    Style="{StaticResource GameModeButtonStyle}"
                    Tag="AI">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Play against AI" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="The optional AI opponent will be implemented in a later phase."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
