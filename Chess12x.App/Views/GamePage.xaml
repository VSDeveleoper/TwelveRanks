<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Chess12x.App.Views.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#146B43" />
            <GradientStop Offset="1" Color="#084B30" />
        </LinearGradientBrush>
    </Page.Background>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="4,0,4,12">
            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Game board" />
            <TextBlock
                x:Name="ModeText"
                Foreground="#D9FFFFFF"
                Text="Choose a game mode from Home." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*" />
                <ColumnDefinition Width="70*" />
                <ColumnDefinition Width="15*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="15*" />
                <RowDefinition Height="70*" />
                <RowDefinition Height="15*" />
            </Grid.RowDefinitions>

            <Border
                Grid.RowSpan="3"
                Margin="0,12,16,12"
                Padding="12"
                Background="#26000000"
                CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Captured by White"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="#BFFFFFFF"
                        Text="No pieces captured"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Viewbox
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Stretch="Uniform">
                <Border
                    Width="720"
                    Height="720"
                    BorderBrush="#3A2D22"
                    BorderThickness="10"
                    CornerRadius="4">
                    <Grid x:Name="BoardGrid" />
                </Border>
            </Viewbox>

            <Border
                Grid.RowSpan="3"
                Grid.Column="2"
                Margin="16,12,0,12"
                Padding="12"
                Background="#26000000"
                CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Captured by Black"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="#BFFFFFFF"
                        Text="No pieces captured"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
