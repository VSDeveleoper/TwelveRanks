<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TwelveRanks.App.Views.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#146B43" />
            <GradientStop Offset="1" Color="#084B30" />
        </LinearGradientBrush>
    </Page.Background>

    <Grid Padding="24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*" />
                <ColumnDefinition Width="70*" />
                <ColumnDefinition Width="15*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" />
                <RowDefinition Height="90*" />
                <RowDefinition Height="5*" />
            </Grid.RowDefinitions>

            <Border
                Grid.RowSpan="3"
                Margin="0,12"
                Padding="12"
                Background="#26000000"
                CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="CapturedByWhiteTitle"
                        FontWeight="SemiBold"
                        Foreground="White"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="CapturedByWhiteEmptyText"
                        x:Uid="CapturedByWhiteEmptyText"
                        Foreground="#BFFFFFFF"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Grid
                        x:Name="CapturedByWhiteGrid"
                        AutomationProperties.AutomationId="CapturedByWhiteList"
                        ColumnSpacing="4"
                        RowSpacing="4" />
                </StackPanel>
            </Border>

            <Viewbox
                x:Name="BoardViewbox"
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                SizeChanged="OnBoardViewboxSizeChanged"
                VerticalAlignment="Stretch"
                Stretch="Uniform">
                <Border
                    x:Name="BoardFrame"
                    Width="720"
                    Height="720"
                    BorderBrush="#3A2D22"
                    BorderThickness="10"
                    CornerRadius="4">
                    <Grid
                        x:Name="BoardSurface"
                        Background="#3A2D22"
                        FlowDirection="LeftToRight">
                        <Grid.RowDefinitions>
                            <RowDefinition
                                x:Name="TopCoordinateRow"
                                Height="22" />
                            <RowDefinition Height="*" />
                            <RowDefinition
                                x:Name="BottomCoordinateRow"
                                Height="22" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                x:Name="LeftCoordinateColumn"
                                Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition
                                x:Name="RightCoordinateColumn"
                                Width="22" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            x:Name="TopFileCoordinates"
                            Grid.Column="1"
                            IsHitTestVisible="False" />
                        <Grid
                            x:Name="BottomFileCoordinates"
                            Grid.Row="2"
                            Grid.Column="1"
                            IsHitTestVisible="False" />
                        <Grid
                            x:Name="LeftRankCoordinates"
                            Grid.Row="1"
                            IsHitTestVisible="False" />
                        <Grid
                            x:Name="RightRankCoordinates"
                            Grid.Row="1"
                            Grid.Column="2"
                            IsHitTestVisible="False" />

                        <Grid
                            x:Name="BoardGrid"
                            Grid.Row="1"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="ChessBoard"
                            FlowDirection="LeftToRight"
                            TabFocusNavigation="Once"
                            XYFocusKeyboardNavigation="Enabled" />
                    </Grid>
                </Border>
            </Viewbox>

            <Border
                Grid.RowSpan="3"
                Grid.Column="2"
                Margin="0,12"
                Padding="12"
                Background="#26000000"
                CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="CapturedByBlackTitle"
                        FontWeight="SemiBold"
                        Foreground="White"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="CapturedByBlackEmptyText"
                        x:Uid="CapturedByBlackEmptyText"
                        Foreground="#BFFFFFFF"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Grid
                        x:Name="CapturedByBlackGrid"
                        AutomationProperties.AutomationId="CapturedByBlackList"
                        ColumnSpacing="4"
                        RowSpacing="4" />
                </StackPanel>
            </Border>
        </Grid>

        <Border
            Grid.Row="1"
            MinHeight="36"
            Margin="0,12,0,0"
            Padding="12,6"
            Background="#26000000"
            CornerRadius="8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="ModeText"
                    x:Uid="GameModeText"
                    AutomationProperties.AutomationId="GameModeText"
                    Foreground="#D9FFFFFF"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="WhiteResignButton"
                        MinHeight="28"
                        Padding="10,2"
                        AutomationProperties.AutomationId="WhiteResign"
                        Click="WhiteResignButton_Click"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="BlackResignButton"
                        MinHeight="28"
                        Padding="10,2"
                        AutomationProperties.AutomationId="BlackResign"
                        Click="BlackResignButton_Click"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        x:Name="ComputerThinkingIndicator"
                        x:Uid="ComputerThinkingIndicator"
                        Width="18"
                        Height="18"
                        AutomationProperties.AutomationId="ComputerThinkingIndicator"
                        Foreground="White"
                        IsActive="False"
                        IsTabStop="False"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="GameStatusText"
                        x:Uid="GameStatusText"
                        AutomationProperties.AutomationId="GameStatusText"
                        AutomationProperties.LiveSetting="Polite"
                        FontWeight="SemiBold"
                        Foreground="White"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
