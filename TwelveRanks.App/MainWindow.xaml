<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TwelveRanks.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Twelve Ranks"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="TopNavigation"
        AlwaysShowHeader="False"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Top"
        SelectionChanged="TopNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="HomeNavigationItem"
                x:Uid="NavHome"
                AutomationProperties.AutomationId="NavHome"
                Tag="home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="GameNavigationItem"
                x:Uid="NavGame"
                AutomationProperties.AutomationId="NavGame"
                Tag="game">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Play" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="RulesNavigationItem"
                x:Uid="NavRules"
                AutomationProperties.AutomationId="NavRules"
                Tag="rules">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Help" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="SettingsNavigationItem"
                x:Uid="NavSettings"
                AutomationProperties.AutomationId="NavSettings"
                Tag="settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <CommandBar
                x:Name="GameCommandBar"
                HorizontalAlignment="Right"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="False"
                Visibility="Collapsed">
                <AppBarButton
                    x:Name="UndoButton"
                    x:Uid="UndoButton"
                    AutomationProperties.AutomationId="UndoMove"
                    Click="UndoButton_Click"
                    Icon="Undo"
                    IsEnabled="False">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="Z"
                            Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    x:Name="RedoButton"
                    x:Uid="RedoButton"
                    AutomationProperties.AutomationId="RedoMove"
                    Click="RedoButton_Click"
                    Icon="Redo"
                    IsEnabled="False">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="Y"
                            Modifiers="Control" />
                        <KeyboardAccelerator
                            Key="Z"
                            Modifiers="Control,Shift" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton
                    x:Name="EndGameButton"
                    x:Uid="EndGameButton"
                    AutomationProperties.AutomationId="EndGame"
                    Click="EndGameButton_Click"
                    Icon="Stop"
                    IsEnabled="False" />
            </CommandBar>
        </NavigationView.PaneFooter>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
